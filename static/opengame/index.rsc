d:["$","section",null,{"className":"chapter","id":"mechanism","children":[["$","div",null,{"className":"chapter-head","children":[["$","div",null,{"className":"eyebrow","children":"01 / THE TECH"}],["$","h2",null,{"children":"First, separate the model from the game."}],["$","p",null,{"className":"prose","children":"Think of a simple request: “Make a game where I fly to a planet, land, and look for a lost object.” There are several ways AI can help—and they do not produce the same thing."}]]}],["$","div",null,{"className":"three","children":[["$","article",null,{"children":[["$","span",null,{"className":"number","children":"A"}],["$","h3",null,{"children":"Write the game"}],["$","div",null,{"className":"path","children":"Prompt → code → engine → play"}],["$","p",null,{"children":"A coding agent writes movement, cameras, scores and interfaces. The engine is the software that runs the rules and draws the result. Once built, a conventional game does not need the coding model to decide every frame."}],["$","p",null,{"className":"example","children":"Example: Void Explorer’s flight and landing."}]]}],["$","article",null,{"children":[["$","span",null,{"className":"number","children":"B"}],["$","h3",null,{"children":"Build its world"}],["$","div",null,{"className":"path","children":"Prompt → 3D assets → engine → play"}],["$","p",null,{"children":"A model makes the environment or objects. Developers then add rules and interactions. A beautiful room is not yet a game: it needs such things as solid walls, usable doors and a reason to explore."}],["$","p",null,{"className":"example","children":"Example: Marble scenery in ICARE."}]]}],["$","article",null,{"children":[["$","span",null,{"className":"number","children":"C"}],["$","h3",null,{"children":"Generate as you play"}],["$","div",null,{"className":"path","children":"Frames + action → model → next frames"}],["$","p",null,{"children":"An interactive world model synthesizes the next view from context and player input. It can invent a place without first assembling a normal game project. Long memory, exact rules and shared multiplayer state are much harder requirements."}],["$","p",null,{"className":"example","children":"Example: Google’s Project Genie."}]]}]]}],["$","p",null,{"className":"source-note","children":["Architectural synthesis from the linked implementations. A product can combine these approaches. ",["$","span",null,{"className":"refs","children":[["$","a","astra",{"href":"https://developers.openai.com/blog/how-to-build-games-with-astra","target":"_blank","rel":"noreferrer","children":["Thomas Ricouard / OpenAI"," ↗"]}],["$","a","icare",{"href":"https://www.worldlabs.ai/case-studies/icare","target":"_blank","rel":"noreferrer","children":["World Labs + WithLore"," ↗"]}],["$","a","genie",{"href":"https://deepmind.google/blog/genie-3-a-new-frontier-for-world-models/","target":"_blank","rel":"noreferrer","children":["Google DeepMind"," ↗"]}]]}]]}],["$","$L15",null,{}],["$","div",null,{"className":"spread","children":[["$","div",null,{"children":[["$","h3",null,{"children":"Why “the models got better” really matters"}],["$","p",null,{"className":"prose","children":"The useful unit of progress is a completed loop. Can the system understand an idea, change several related files, run the result, see what broke and repair it without losing the original intent?"}],["$","p",null,{"children":"Imagine the ship sinks through the planet. A text-only assistant can suggest a collision formula. An agent with tools can inspect the code, reproduce the landing, read the coordinates, change the collision logic and try again. That is a much larger reduction in work than faster autocomplete."}]]}],["$","div",null,{"className":"loop","children":[["$","span",null,{"children":"HUMAN INTENT"}],["$","strong",null,{"children":"“Landing feels too floaty.”"}],["$","ol",null,{"children":[["$","li",null,{"children":[["$","b",null,{"children":"Understand"}],["$","small",null,{"children":"Read the project and constraints"}]]}],["$","li",null,{"children":[["$","b",null,{"children":"Act"}],["$","small",null,{"children":"Edit code, assets and settings"}]]}],"$L16","$L17"]}],"$L18"]}]]}],"$L19","$L1a","$L1b","$L1c"]}]
e:["$","section",null,{"className":"chapter","id":"makers","children":[["$","div",null,{"className":"chapter-head","children":[["$","div",null,{"className":"eyebrow","children":"02 / THE PEOPLE"}],["$","h2",null,{"children":"Meet the people crossing the old barriers."}],["$","p",null,{"className":"prose","children":"These examples show different kinds of progress: a professional can work with a smaller team; a domain expert can become a creator; a designer can build beyond their technical background."}]]}],[["$","article","01",{"className":"case","children":[["$","div",null,{"className":"case-heading","children":[["$","span",null,{"className":"number","children":"01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Damian Pannell"}],["$","span",null,{"children":"25 years in game art and direction"}]]}]]}],["$","div",null,{"className":"case-grid","children":[["$","figure",null,{"children":[["$","img",null,{"src":"https://cdn.prod.website-files.com/65d4fd4fde0a4c6508db25aa/6a58d711301367d67c49df21_6a58d5a578bf213c51a66ee5_hollow-signal-directional-shooting.jpeg","alt":"Hollow Signal gameplay showing directional shooting in an arcade arena","width":"960","height":"600","loading":"lazy"}],["$","figcaption",null,{"children":["Hollow Signal. Notice the deliberately narrow arcade format: a controlled scope makes repeated polishing possible.",["$","span",null,{"className":"credit","children":"Image: Damian Pannell / Rosebud"}]]}]]}],["$","div",null,{"children":[["$","h3",null,{"className":"case-title","children":"The experienced director, now working solo."}],["$","div",null,{"className":"case-metric","children":[["$","strong",null,{"children":"7–8 weeks"}],["$","span",null,{"children":"to an approved Steam page, maker-reported"}]]}],["$","p",null,{"children":"After roughly ten prototypes in Rosebud, Pannell chose Hollow Signal: an arcade roguelike with manual directional shooting. He used different models for simple and difficult changes, and added debug controls to jump directly to bosses. Steam confirms a July 14 release."}],["$","p",null,{"className":"lesson-point","children":[["$","b",null,{"children":"What you learn."}]," ","AI reduces the distance between taste and implementation. His advantage includes knowing which prototype deserves another week—and which ones to abandon."]}],["$","details",null,{"children":[["$","summary",null,{"children":"What this result does—and does not—prove"}],["$","p",null,{"children":"A released game is a concrete result. The store had just one visible review at research time; commercial demand is not established."}]]}],["$","span",null,{"className":"refs","children":[["$","a","hollow",{"href":"https://lab.rosebud.ai/blog/hollow-signal-damian-pannell-solo-steam-launch","target":"_blank","rel":"noreferrer","children":["Rosebud + Damian Pannell"," ↗"]}],["$","a","steam",{"href":"https://store.steampowered.com/app/4841030/Hollow_Signal/","target":"_blank","rel":"noreferrer","children":["Steam"," ↗"]}]]}],["$","a",null,{"className":"text-link","href":"https://store.steampowered.com/app/4841030/Hollow_Signal/","target":"_blank","rel":"noreferrer","children":["See the released game"," ↗"]}]]}]]}]]}],["$","article","02",{"className":"case","children":[["$","div",null,{"className":"case-heading","children":[["$","span",null,{"className":"number","children":"02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Dr. Sidney Chu"}],["$","span",null,{"children":"Pediatrician / Heydoc"}]]}]]}],["$","div",null,{"className":"case-grid","children":[["$","figure",null,{"children":[["$","img",null,{"src":"https://cdn.prod.website-files.com/65d4fd4fde0a4c6508db25aa/6a14cbefc5de2ad06be34908_4043d4_b318995ab9bd40d490f297e1aaedf2f3~mv2.jpeg","alt":"Heydoc game console in a clinic waiting-room setting","width":"960","height":"600","loading":"lazy"}],["$","figcaption",null,{"children":["Heydoc puts browser games in clinic waiting rooms. Distribution is a physical place with a real reason to play.",["$","span",null,{"className":"credit","children":"Image: Heydoc / Rosebud"}]]}]]}],["$","div",null,{"children":[["$","h3",null,{"className":"case-title","children":"The domain expert with an audience already waiting."}],"$L1d","$L1e","$L1f","$L20","$L21","$L22"]}]]}]]}],"$L23"],"$L24","$L25"]}]
f:["$","section",null,{"className":"chapter","id":"products","children":[["$","div",null,{"className":"chapter-head","children":[["$","div",null,{"className":"eyebrow","children":"03 / THE PRODUCTS"}],["$","h2",null,{"children":"The competition is becoming a complete workflow."}],["$","p",null,{"className":"prose","children":"An impressive first generation gets attention. A useful product makes the next fifty changes easier, preserves what already works, and gives the finished game somewhere to go."}]]}],["$","div",null,{"className":"product-map","children":[["$","div",null,{"className":"map-head","children":[["$","span",null,{"children":"PRODUCT FAMILY"}],["$","span",null,{"children":"WHAT IT PUTS AROUND THE MODEL"}],["$","span",null,{"children":"WHAT TO LOOK FOR"}]]}],[["$","div","General coding agents",{"className":"map-row","children":[["$","div",null,{"children":[["$","b",null,{"children":"General coding agents"}],["$","small",null,{"children":"Codex, Claude Code, Cursor, Replit"}]]}],["$","p",null,{"children":"Code, tools, project context, tests and deployment"}],["$","p",null,{"children":"Can a creator assemble everything without becoming the integration engineer?"}]]}],["$","div","Game-creation studios",{"className":"map-row","children":[["$","div",null,{"children":[["$","b",null,{"children":"Game-creation studios"}],["$","small",null,{"children":"Rosebud; OpenGame’s stated direction"}]]}],["$","p",null,{"children":"Game-specific templates, editing, assets, hosting and remixing"}],["$","p",null,{"children":"Does the tenth iteration stay understandable and editable?"}]]}],["$","div","Established game engines",{"className":"map-row","children":[["$","div",null,{"children":[["$","b",null,{"children":"Established game engines"}],["$","small",null,{"children":"Roblox Studio; Unity AI"}]]}],["$","p",null,{"children":"An existing scene, game runtime, production tools and ecosystem"}],["$","p",null,{"children":"How much work can the agent safely perform inside a real project?"}]]}],["$","div","AI-enabled UGC platforms",{"className":"map-row","children":[["$","div",null,{"children":[["$","b",null,{"children":"AI-enabled UGC platforms"}],["$","small",null,{"children":"Roblox Build; OpenGame’s ambition"}]]}],["$","p",null,{"children":"Creation alongside discovery, players, identity and monetization"}],["$","p",null,{"children":"Do creators find an audience—and do those players return?"}]]}]]]}],["$","p",null,{"className":"source-note","children":"A map of product approaches, not a feature-completeness ranking. OpenGame’s positioning comes from the referral context you shared; its architecture and current feature coverage remain unverified."}],["$","div",null,{"className":"spread","children":[["$","div",null,{"children":[["$","h3",null,{"children":"The model gets “hands” inside the engine."}],["$","p",null,{"children":"Roblox reported that 44% of its top 1,000 creators used Assistant or third-party AI through MCP during March 6–April 7. That is any such use among a cohort ranked by Robux spent inside their games—not 44% of all developers, or of fully AI-made games."}],["$","p",null,{"children":"Its agentic workflow plans and edits; automated playtesting was introduced in beta. Unity’s May open beta similarly lets an agent inspect scenes and work with scripts, components and prefabs."}],["$","p",null,{"children":[["$","b",null,{"children":"MCP"}]," is a standard way to connect a model to tools. It gives the model access to the project and actions; it does not itself improve the model’s intelligence."]}],["$","span",null,{"className":"refs","children":[["$","a","agentic",{"href":"https://about.roblox.com/newsroom/2026/04/roblox-studio-going-agentic","target":"_blank","rel":"noreferrer","children":["Roblox"," ↗"]}],["$","a","unity",{"href":"https://unity.com/blog/unity-ai-how-to-get-started","target":"_blank","rel":"noreferrer","children":["Unity"," ↗"]}]]}]]}],["$","div",null,{"className":"news-block","children":[["$","div",null,{"className":"eyebrow","children":"SEPTEMBER 11 / ROBLOX BUILD"}],["$","div",null,{"className":"big-pair","children":[["$","strong",null,{"children":["~9,000","$L26"]}],"$L27"]}],"$L28","$L29","$L2a"]}]]}],"$L2b","$L2c"]}]
10:["$","section",null,{"className":"chapter","id":"frontier","children":[["$","div",null,{"className":"chapter-head","children":[["$","div",null,{"className":"eyebrow","children":"04 / THE FRONTIER"}],["$","h2",null,{"children":"When the model becomes part of the world."}],["$","p",null,{"className":"prose","children":"This is the most visually astonishing part of the market. It is also where a short video can most easily suggest a more complete product than actually exists."}]]}],["$","div",null,{"className":"frontier-grid","children":[["$","article",null,{"children":[["$","span",null,{"className":"status","children":"RESEARCH → LIMITED PRODUCT"}],["$","h3",null,{"children":"Genie: an imagined place you can navigate."}],["$","p",null,{"children":"Genie 3’s August 2025 research showed generated worlds at 720p and 24 frames per second, with interaction lasting a few minutes. Project Genie’s January 2026 US launch offered eligible adult AI Ultra subscribers a browser prototype for creating, exploring and remixing worlds."}],["$","p",null,{"children":"The public prototype capped generations at 60 seconds and acknowledged control latency and imperfect physics. Model capability and product availability are different things. These are dated launch limits, not a claim that improvement stops there."}],["$","a",null,{"className":"text-link","href":"https://www.youtube.com/watch?v=PDKhUknuQDg","target":"_blank","rel":"noreferrer","children":"Watch Google’s showcase ↗"}],["$","span",null,{"className":"refs","children":[["$","a","genie",{"href":"https://deepmind.google/blog/genie-3-a-new-frontier-for-world-models/","target":"_blank","rel":"noreferrer","children":["Google DeepMind"," ↗"]}],["$","a","projectgenie",{"href":"https://blog.google/innovation-and-ai/models-and-research/google-deepmind/project-genie/","target":"_blank","rel":"noreferrer","children":["Google"," ↗"]}]]}]]}],["$","article",null,{"children":[["$","span",null,{"className":"status","children":"SEPTEMBER 1 / EARLY ACCESS"}],["$","h3",null,{"children":"Atlas: give the model actual spatial context."}],["$","p",null,{"children":"World Labs’ new model takes images, video, camera positions and depth. In its cottage demonstration, one photo leaves much of the scene imagined; adding photos constrains the reconstruction."}],["$","p",null,{"children":"It can output precisely controlled views and explicit 3D representations, including Gaussian splats. The announcement shows up to one-minute, 1440p videos. Atlas is in select-partner early access and is intended to power future Marble versions; it is not the same as the already available Marble workflow."}],["$","a",null,{"className":"text-link","href":"https://www.worldlabs.ai/blog/atlas","target":"_blank","rel":"noreferrer","children":"Explore the interactive reconstruction examples ↗"}],["$","span",null,{"className":"refs","children":[["$","a","atlas",{"href":"https://www.worldlabs.ai/blog/atlas","target":"_blank","rel":"noreferrer","children":["World Labs"," ↗"]}]]}]]}]]}],["$","div",null,{"className":"bug-story","children":[["$","span",null,{"className":"eyebrow","children":"THE BUG THAT EXPLAINS THE CATEGORY"}],["$","h3",null,{"children":"Look at the floor. Look back. Where did the enemy go?"}],["$","p",null,{"children":"Microsoft’s April 2025 WHAMM Quake II demo used just 0.9 seconds of context. The researchers described enemies disappearing or changing when a player looked away; health and damage were also unreliable. It was progress in responsive generation—640 × 360 at over 10 fps—but not a faithful implementation of Quake’s rules."}],["$","p",null,{"children":[["$","b",null,{"children":"Keep this distinction:"}]," a world can look convincing without having reliable memory. Newer approaches are improving memory; the example explains the engineering problem rather than defining every current model’s limit. ","$L2d"]}]]}],"$L2e","$L2f","$L30","$L31"]}]
11:["$","section",null,{"className":"chapter","id":"adoption","children":[["$","div",null,{"className":"chapter-head","children":[["$","div",null,{"className":"eyebrow","children":"05 / THE EVIDENCE"}],["$","h2",null,{"children":"“People made things” is only the first signal."}],["$","p",null,{"className":"prose","children":"The evidence is strongest for new people creating and small teams shipping. Evidence of durable player demand is thinner, unevenly disclosed, and easy to overstate."}]]}],["$","div",null,{"className":"evidence-ladder","children":[["$","div",null,{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Creation"}],["$","p",null,{"children":"Can someone make or publish a game?"}],["$","b",null,{"children":"Roblox Build’s published games"}],["$","small",null,{"children":"Output and new participation"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Delivery"}],["$","p",null,{"children":"Does it work outside the demo?"}],["$","b",null,{"children":"Hollow Signal / SpookSeek"}],["$","small",null,{"children":"Verified store releases"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Use"}],["$","p",null,{"children":"Do real people show up?"}],["$","b",null,{"children":"Heydoc / GeoSports"}],["$","small",null,{"children":"Reported deployment and usage"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"04"}],["$","h3",null,{"children":"Durability"}],["$","p",null,{"children":"Do people return and pay over time?"}],["$","b",null,{"children":"Still needs cohort evidence"}],["$","small",null,{"children":"Not established market-wide here"}]]}]]}],["$","p",null,{"className":"source-note","children":"An evidence ladder, not a measured funnel. These are different products and populations; there are no implied conversion rates between the boxes."}],["$","div",null,{"className":"spread","children":[["$","div",null,{"children":[["$","h3",null,{"children":"Learn to read the denominator."}],["$","p",null,{"children":[["$","b",null,{"children":"Games made"}]," can include unfinished experiments. ",["$","b",null,{"children":"Published games"}]," prove availability, not demand. ",["$","b",null,{"children":"Daily players"}]," measure activity, but a single reported snapshot does not show retention. ",["$","b",null,{"children":"Annualized revenue"}]," extrapolates a shorter period; it does not mean that cash has already arrived."]}],["$","p",null,{"children":["Retention asks a different question: of the people who started in the same period, how many returned a week or month later? A ",["$","b",null,{"children":"cohort"}]," is that shared starting group. If a new wave of visitors replaces everyone who left, overall user growth can hide weak retention."]}]]}],["$","div",null,{"className":"study-card","children":[["$","span",null,{"className":"eyebrow","children":"A HYPOTHETICAL EXAMPLE"}],["$","h3",null,{"children":"1,000 visitors arrive."}],["$","div",null,{"className":"retention-bars","children":[["$","div",null,{"children":[["$","span",null,{"children":"Week 1"}],["$","i",null,{"style":{"width":"100%"}}],["$","b",null,{"children":"1,000"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Week 2"}],["$","i",null,{"style":{"width":"20%"}}],["$","b",null,{"children":"200 return"}]]}]]}],["$","p",null,{"children":"Now another 1,000 new people arrive. Total activity looks healthy, but only 20% of the original group returned."}],["$","small",null,{"children":"Made-up numbers for teaching—not data from OpenGame or any company in this guide."}]]}]]}],["$","h3",null,{"children":"What the market teaches us so far"}],["$","div",null,{"className":"takeaways","children":[["$","p",null,{"children":[["$","b",null,{"children":"Technical access is expanding."}]," The named makers show that coding, 3D math and asset production are less exclusive barriers than before."]}],["$","p",null,{"children":[["$","b",null,{"children":"Human expertise changes shape."}]," Selecting a good concept, recognizing a bad result and directing revisions become more consequential as implementation gets cheaper."]}],["$","p",null,{"children":[["$","b",null,{"children":"Distribution has not disappeared."}]," A sports creator’s audience and a pediatrician’s clinics explain access to users that model capability alone does not supply."]}],"$L32"]}]]}]
12:["$","section",null,{"className":"chapter opengame","id":"opengame","children":[["$","div",null,{"className":"chapter-head","children":[["$","div",null,{"className":"eyebrow","children":"06 / BACK TO OPENGAME"}],["$","h2",null,{"children":"Your excitement makes sense. Here is what to look for next."}],["$","p",null,{"className":"prose","children":"OpenGame sits near the intersection of the strongest changes: better coding agents, richer generated assets, easier browser distribution, and more people able to create."}]]}],["$","div",null,{"className":"open-context","children":[["$","div",null,{"className":"eyebrow","children":"WHAT WE ACTUALLY KNOW"}],["$","p",null,{"children":"DanJ’s referral describes Rishi Prasad and Matt Balsei building a game harness and studio, importing games made with external coding agents, enabling remixes, and giving players a browser-first home for high-quality user-generated games. You and Daniel reacted positively to the built work and presentation."}],["$","p",null,{"children":"That gives us a product ambition. It does not yet establish OpenGame’s internal architecture, creator retention, player retention, margins or scale. The teaser itself was not independently played or reviewed for this guide."}],["$","a",null,{"href":"https://www.notion.so/3dbdaeb290268166b71ee4a00b024c50","target":"_blank","rel":"noreferrer","children":"Your sourced OpenGame record ↗"}]]}],["$","div",null,{"className":"bet","children":[["$","span",null,{"className":"eyebrow","children":"THE PRODUCT QUESTION"}],["$","p",null,{"children":["When everyone can access a strong model, what makes someone want to ",["$","em",null,{"children":"create, keep creating, and play"}]," here?"]}]]}],["$","div",null,{"className":"two-notes","children":[["$","article",null,{"children":[["$","h3",null,{"children":"The opportunity"}],["$","p",null,{"children":"OpenGame could make a fragmented process feel continuous: bring an idea or existing agent-built game, refine it without breaking it, publish instantly, find players, and build on other people’s work. The lasting value could live in the project representation, reliability, community and discovery."}],["$","p",null,{"children":"Its support for externally built games could be particularly useful: creators may already love their coding agent and primarily need a home, feedback and an audience."}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"The competitive pressure"}],["$","p",null,{"children":"General agents keep absorbing more of the build process. Specialized studios are learning the game workflow. Roblox brings an existing player network and monetization. A new platform needs a reason for a specific group to choose it even as all three improve."}],["$","p",null,{"children":"“Better models will make this work” is an enabling thesis. “This group will build and play here repeatedly” is the product thesis that still needs evidence."}]]}]]}],["$","h3",null,{"children":"Six demonstrations that would teach you more than a polished pitch"}],["$","div",null,{"className":"questions","children":[["$","details","Watch a fresh creator build.",{"open":true,"children":[["$","summary",null,{"children":[["$","span",null,{"children":["0",1]}],"Watch a fresh creator build."]}],["$","p",null,{"children":"Start with a blank project. Measure time to the first playable result, how often help is needed, and whether the creator can make a specific second change."}],["$","p",null,{"className":"question-why","children":"This tests usability, not just the founders’ ability to operate the tool."}]]}],["$","details","Break something, then repair it.",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":["0",2]}],"Break something, then repair it."]}],["$","p",null,{"children":"Change movement, add multiplayer, or import an outside agent’s project. Show what survives and how a failed change is undone."}],"$L33"]}],"$L34","$L35","$L36","$L37"]}],"$L38"]}]
13:["$","section",null,{"className":"sources","id":"sources","children":[["$","div",null,{"className":"eyebrow","children":"READING NOTES & SOURCES"}],["$","h2",null,{"children":"Follow the evidence."}],["$","p",null,{"children":"This guide combines primary technical announcements, maker interviews and live product/store pages checked through September 14, 2026. Vendor and creator results are labeled as reported; releases were checked separately where possible. Media are official demonstrations or maker-supplied images, not generated illustrations. We read the sources and selected media; we did not fully watch every video or personally play-test these games. Product diagrams and strategic implications are our synthesis."}],["$","p",null,{"children":"The page borrows gadi.fm’s restrained typography, white background and green accents, with longer-form reading treatments from its editorial pages. Source media remain credited to their makers."}],["$","details",null,{"children":[["$","summary",null,{"children":"Full source notebook · dates and original links"}],["$","ol",null,{"children":[[["$","li","fable",{"children":[["$","a",null,{"href":"https://www.anthropic.com/claude-fable-and-mythos-5-1","target":"_blank","rel":"noreferrer","children":["Fable 5.1 and Mythos 5.1"," ↗"]}],["$","span",null,{"children":["Anthropic"," · ","September 2026"]}]]}],["$","li","cursor",{"children":[["$","a",null,{"href":"https://cursor.com/changelog/projects","target":"_blank","rel":"noreferrer","children":["Cursor Projects"," ↗"]}],["$","span",null,{"children":["Cursor"," · ","September 10, 2026"]}]]}],["$","li","astra",{"children":[["$","a",null,{"href":"https://developers.openai.com/blog/how-to-build-games-with-astra","target":"_blank","rel":"noreferrer","children":["Building games with Astra"," ↗"]}],["$","span",null,{"children":["Thomas Ricouard / OpenAI"," · ","September 4, 2026"]}]]}],["$","li","hollow",{"children":[["$","a",null,{"href":"https://lab.rosebud.ai/blog/hollow-signal-damian-pannell-solo-steam-launch","target":"_blank","rel":"noreferrer","children":["Hollow Signal creator interview"," ↗"]}],["$","span",null,{"children":["Rosebud + Damian Pannell"," · ","July 10, 2026; subsequently updated"]}]]}],["$","li","steam",{"children":[["$","a",null,{"href":"https://store.steampowered.com/app/4841030/Hollow_Signal/","target":"_blank","rel":"noreferrer","children":["Hollow Signal store listing"," ↗"]}],["$","span",null,{"children":["Steam"," · ","Release: July 14, 2026; checked September 14"]}]]}],["$","li","heydoc",{"children":[["$","a",null,{"href":"https://lab.rosebud.ai/blog/from-waiting-room-boredom-to-life-saving-lessons-how-heydoc-built-40-health-games-on-rosebud","target":"_blank","rel":"noreferrer","children":["Heydoc clinic game workflow"," ↗"]}],["$","span",null,{"children":["Rosebud + Dr. Sidney Chu"," · ","May 25, 2026"]}]]}],["$","li","pilot",{"children":[["$","a",null,{"href":"https://www.heydoc.co/","target":"_blank","rel":"noreferrer","children":["Pilot results and survey description"," ↗"]}],["$","span",null,{"children":["Heydoc"," · ","Checked September 14, 2026"]}]]}],["$","li","ruth",{"children":[["$","a",null,{"href":"https://replit.com/blog/building-ar-mobile-app-on-replit","target":"_blank","rel":"noreferrer","children":["Building an AR mobile app"," ↗"]}],["$","span",null,{"children":["Replit + Ruth Heasman"," · ","February 27, 2026; updated March 1"]}]]}],["$","li","appstore",{"children":[["$","a",null,{"href":"https://apps.apple.com/us/app/spookseek-ar/id6758890449","target":"_blank","rel":"noreferrer","children":["SpookSeek AR"," ↗"]}],["$","span",null,{"children":["Apple App Store"," · ","Checked September 14, 2026"]}]]}],["$","li","icare",{"children":[["$","a",null,{"href":"https://www.worldlabs.ai/case-studies/icare","target":"_blank","rel":"noreferrer","children":["How WithLore built ICARE"," ↗"]}],["$","span",null,{"children":["World Labs + WithLore"," · ","June 2026"]}]]}],["$","li","cube",{"children":[["$","a",null,{"href":"https://about.roblox.com/newsroom/2026/02/accelerating-creation-powered-roblox-cube-foundation-model","target":"_blank","rel":"noreferrer","children":["Functional generation with Cube"," ↗"]}],"$L39"]}],"$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46"],"$L47","$L48"]}]]}]]}]
