23:["$","article","03",{"className":"case","children":[["$","div",null,{"className":"case-heading","children":[["$","span",null,{"className":"number","children":"03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ruth Heasman"}],["$","span",null,{"children":"Designer / SpookSeek AR"}]]}]]}],["$","div",null,{"className":"case-grid","children":[["$","figure",null,{"children":[["$","img",null,{"src":"https://spookseek-ar.com/assets/images/hero-graphic-landing.png","alt":"SpookSeek AR promotional gameplay showing ghosts over a phone camera view","width":"960","height":"600","loading":"lazy"}],["$","figcaption",null,{"children":["SpookSeek AR overlays ghosts on the camera view. The hidden difficulty is translating phone movement into consistent positions.",["$","span",null,{"className":"credit","children":"Image: Ruth Heasman / SpookSeek AR"}]]}]]}],["$","div",null,{"children":[["$","h3",null,{"className":"case-title","children":"A visual idea crosses a technical barrier."}],["$","div",null,{"className":"case-metric","children":[["$","strong",null,{"children":"1 week"}],["$","span",null,{"children":"initial buildathon / TestFlight sprint"}]]}],["$","p",null,{"children":"With ARKit unavailable in her Expo workflow, Heasman and Replit Agent built a custom Three.js system. Ghosts occupy an invisible sphere around the phone; camera angles determine their on-screen positions. One difficult bug became solvable after a model upgrade, she reports. Development-to-production debugging still took work. The app is now in Apple’s store under her name."}],["$","p",null,{"className":"lesson-point","children":[["$","b",null,{"children":"What you learn."}]," ","Better models can make unfamiliar mathematics and frameworks accessible. Getting a prototype running and shipping it reliably are still different milestones."]}],["$","details",null,{"children":[["$","summary",null,{"children":"What this result does—and does not—prove"}],["$","p",null,{"children":"The one-week figure is the initial sprint, not verified end-to-end App Store delivery. No download or revenue result is disclosed."}]]}],["$","span",null,{"className":"refs","children":[["$","a","ruth",{"href":"https://replit.com/blog/building-ar-mobile-app-on-replit","target":"_blank","rel":"noreferrer","children":["Replit + Ruth Heasman"," ↗"]}],["$","a","appstore",{"href":"https://apps.apple.com/us/app/spookseek-ar/id6758890449","target":"_blank","rel":"noreferrer","children":["Apple App Store"," ↗"]}]]}],["$","a",null,{"className":"text-link","href":"https://apps.apple.com/us/app/spookseek-ar/id6758890449","target":"_blank","rel":"noreferrer","children":["See the iPhone release"," ↗"]}]]}]]}]]}]
24:["$","article",null,{"className":"team-case","children":[["$","div",null,{"className":"eyebrow","children":"04 / WITHLORE · ICARE"}],["$","h3",null,{"children":"Three people, several AI tools, one coherent world."}],["$","p",null,{"className":"prose","children":"Loic Picon, Nicholas Hildebrandt and Sunz Kim built ICARE in roughly two months. Their browser experience lets you explore dreamlike places and return tools to historical creative figures."}],["$","div",null,{"className":"recipe","children":[["$","div",null,{"children":[["$","b",null,{"children":"Marble"}],["$","span",null,{"children":"Generated environments"}]]}],["$","em",null,{"children":"+"}],["$","div",null,{"children":[["$","b",null,{"children":"Spark"}],["$","span",null,{"children":"Streams 3D scenery"}]]}],["$","em",null,{"children":"+"}],["$","div",null,{"children":[["$","b",null,{"children":"Three.js + agents"}],["$","span",null,{"children":"Interaction and engineering"}]]}],["$","em",null,{"children":"+"}],["$","div",null,{"children":[["$","b",null,{"children":"Human direction"}],["$","span",null,{"children":"Story, art, integration"}]]}]]}],["$","p",null,{"children":"ElevenLabs and Suno supplied voice and music; Codex and Claude Code helped with engineering. The team still integrated characters, props, terrain and interfaces. Their estimate that a similar scope once would have taken about a year is a studio judgment, not a measured industry-wide speedup."}],["$","p",null,{"className":"lesson-point","children":[["$","b",null,{"children":"What you learn."}]," Several smaller production bottlenecks can fall together. A generated world becomes useful when a team turns it into a coherent experience."]}],["$","a",null,{"className":"text-link","href":"https://www.icare-game.world/","target":"_blank","rel":"noreferrer","children":"Explore ICARE in your browser ↗"}],["$","span",null,{"className":"refs","children":[["$","a","icare",{"href":"https://www.worldlabs.ai/case-studies/icare","target":"_blank","rel":"noreferrer","children":["World Labs + WithLore"," ↗"]}]]}],["$","p",null,{"className":"source-note","children":"Live browser work, with no player-retention or revenue figures disclosed. When exploring, notice which parts are scenery and which parts actually respond to you."}]]}]
25:["$","div",null,{"className":"commercial","children":[["$","div",null,{"children":[["$","div",null,{"className":"eyebrow","children":"05 / FRANK MICHAEL SMITH · GEOSPORTS"}],["$","h3",null,{"children":"A clear game loop meets an existing audience."}],["$","p",null,{"children":"A sports question appears; you tap where it happened on a globe. Five questions make a round. Smith’s July 15 creator interview description reports a 14-hour Claude build and 100,000 daily players."}],["$","p",null,{"children":"Those are reported figures, not audited analytics. Smith already had a media audience; newsletter and social promotion helped distribution. The lesson is the combination: simple interaction, a specific audience, and a reason to return."}],["$","a",null,{"className":"text-link","href":"https://geosports.app/play","target":"_blank","rel":"noreferrer","children":"Try a five-question round ↗"}],["$","p",null,{"className":"source-note","children":[["$","a",null,{"href":"https://www.listennotes.com/podcasts/sportonomics/frank-michael-smith-vibe-pGvfQuKo2ex/","target":"_blank","rel":"noreferrer","children":"Sportonomics episode description ↗"}]," · ",["$","a",null,{"href":"https://www.linkedin.com/posts/tylermwebb_on-sunday-may-3-2026-frank-michael-smith-activity-7482811240055062528-ddej","target":"_blank","rel":"noreferrer","children":"Interviewer’s account ↗"}]]}]]}],["$","div",null,{"children":[["$","div",null,{"className":"eyebrow","children":"06 / PIETER LEVELS · FLY.PIETER.COM"}],["$","h3",null,{"children":"Commercial experimentation can be surprisingly crude."}],["$","figure",null,{"children":[["$","img",null,{"src":"https://r2.levels.io/covers/fly-pieter-com-vibecoded-flight-simulator.jpg","alt":"Pieter Levels’ low-poly flight simulator with branded objects around an airfield","width":"1893","height":"900","loading":"lazy"}],["$","figcaption",null,{"children":"Notice how advertising is part of the world. Image: Pieter Levels."}]]}],["$","p",null,{"children":"Levels reports reaching a $1 million annualized revenue run rate 17 days after starting his browser flight sim in February 2025. That is a historical run rate—not $1 million collected, and not verified recurring revenue today. The live game offers paid aircraft and advertising."}],["$","p",null,{"children":[["$","b",null,{"children":"The useful surprise:"}]," an immediately understandable experience can support a business experiment before it has sophisticated art."]}],["$","p",null,{"className":"source-note","children":[["$","a",null,{"href":"https://levels.io/fly-pieter-com-vibecoded-flight-simulator","target":"_blank","rel":"noreferrer","children":"Creator’s retrospective ↗"}]," · ",["$","a",null,{"href":"https://fly.pieter.com/","target":"_blank","rel":"noreferrer","children":"Fly the game ↗"}]]}]]}]]}]
