27:["$","strong",null,{"children":["71%",["$","small",null,{"children":"of creators were new to Studio"}]]}]
28:["$","p",null,{"children":"Data through September 1. Roblox expanded Build from New Zealand to Serbia and Singapore, with availability varying by age and region. This is real participation by new makers."}]
29:["$","p",null,{"children":"Build already connects creation to mobile analytics and monetization. Browser play and Scene Generator were announced for later in 2026. Standalone distribution and further integrations are still roadmap items in this announcement."}]
2a:["$","span",null,{"className":"refs","children":[["$","a","build",{"href":"https://about.roblox.com/newsroom/2026/09/rdc-2026-the-world-needs-more-play","target":"_blank","rel":"noreferrer","children":["David Baszucki / Roblox"," ↗"]}]]}]
2b:["$","div",null,{"className":"wish","children":[["$","div",null,{"className":"eyebrow","children":"07 / LAKSH’S WISH MASTER · GENERATION BECOMES PLAY"}],["$","h3",null,{"children":"A car-shaped object is not yet a car you can drive."}],["$","div",null,{"className":"car-steps","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Shape"}],["$","span",null,{"children":"A single decorative mesh"}]]}],["$","span",null,{"children":"→"}],["$","div",null,{"children":[["$","strong",null,{"children":"Structure"}],["$","span",null,{"children":"Body + four named wheels"}]]}],["$","span",null,{"children":"→"}],["$","div",null,{"children":[["$","strong",null,{"children":"Behavior"}],["$","span",null,{"children":"Scripts make the parts work together"}]]}],["$","span",null,{"children":"→"}],["$","div",null,{"children":[["$","strong",null,{"children":"Play"}],["$","span",null,{"children":"The player drives their creation"}]]}]]}],["$","p",null,{"children":"Roblox’s Cube workflow connects geometry to a behavior contract. The February beta started with Car-5 and Body-1 schemas, not arbitrary functional objects. In Wish Master, people generate objects while playing; the developer reported over 160,000 objects and 64% longer average playtime among generation users."}],["$","p",null,{"children":"That playtime difference is correlational: enthusiastic players may be more likely to generate in the first place. Still, it illustrates a new product idea. The act of creation can be the entertainment, rather than work done before entertainment begins."}],["$","a",null,{"className":"text-link","href":"https://www.youtube.com/live/PVlCHE9pc50?t=3390s","target":"_blank","rel":"noreferrer","children":"Watch the official functional-generation demo ↗"}],["$","span",null,{"className":"refs","children":[["$","a","cube",{"href":"https://about.roblox.com/newsroom/2026/02/accelerating-creation-powered-roblox-cube-foundation-model","target":"_blank","rel":"noreferrer","children":["Roblox"," ↗"]}]]}]]}]
2c:["$","div",null,{"className":"margin-note","children":[["$","b",null,{"children":"For OpenGame, there are two different customers."}],["$","p",null,{"children":"The person making a game needs speed, control and repair. The person playing needs a good time, friends and something worth returning to. A shared platform must serve both—and help good creations find the right players."}]]}]
2d:["$","span",null,{"className":"refs","children":[["$","a","whamm",{"href":"https://www.microsoft.com/en-us/research/articles/whamm-real-time-world-modelling-of-interactive-environments/","target":"_blank","rel":"noreferrer","children":["Microsoft Research"," ↗"]}]]}]
2e:["$","div",null,{"className":"spread","children":[["$","div",null,{"children":[["$","h3",null,{"children":"The practical middle path is already useful."}],["$","p",null,{"children":["José Tijerín’s ",["$","em",null,{"children":"Gaussian Mansion"}]," starts with artwork, uses Marble to generate persistent environments, then integrates them into an Unreal Engine rail-shooter pilot. He still tunes scene overlap, rendering and interactions. ",["$","span",null,{"className":"refs","children":[["$","a","mansion",{"href":"https://www.worldlabs.ai/case-studies/3-gaussian-mansion","target":"_blank","rel":"noreferrer","children":["World Labs + José Tijerín"," ↗"]}]]}]]}],["$","p",null,{"children":["Rosebud’s multiplayer ",["$","em",null,{"children":"Simon Says"}]," demonstration follows the same logic: generated scenery, separate collision geometry, and templates supplying controls and synchronized objectives. Manual export and setup were still part of its November 2025 workflow. ",["$","span",null,{"className":"refs","children":[["$","a","roseworld",{"href":"https://www.worldlabs.ai/case-studies/rosebud","target":"_blank","rel":"noreferrer","children":["World Labs + Rosebud"," ↗"]}]]}]]}],["$","p",null,{"children":"The design lesson is useful: ask which properties need to be exact. Let generation provide visual richness, while explicit software keeps the score, rules and shared state dependable."}]]}],["$","div",null,{"className":"branch-diagram","children":[["$","span",null,{"children":"GENERATED WORLD"}],["$","div",null,{"className":"branch","children":[["$","b",null,{"children":"Visual representation"}],["$","small",null,{"children":"What it looks like"}]]}],["$","div",null,{"className":"branch","children":[["$","b",null,{"children":"Collision geometry"}],["$","small",null,{"children":"What you can walk through"}]]}],["$","div",null,{"className":"branch","children":[["$","b",null,{"children":"Interactive state"}],["$","small",null,{"children":"What opened, moved or changed"}]]}],["$","div",null,{"className":"branch","children":[["$","b",null,{"children":"Shared runtime"}],["$","small",null,{"children":"What every player agrees happened"}]]}],["$","span",null,{"children":"FOUR JOBS · NOT ONE OUTPUT"}]]}]]}]
2f:["$","div",null,{"className":"two-notes","children":[["$","article",null,{"children":[["$","h3",null,{"children":"A second distinction: restyling vs simulation."}],["$","p",null,{"children":["Decart’s Oasis 2 is a Minecraft mod that changes the live visual style while Minecraft supplies the underlying rules. Oasis 3 Preview, introduced in June, instead accepts driving actions through an API and generates camera frames. Related names, different architectures and users. ",["$","span",null,{"className":"refs","children":[["$","a","oasis2",{"href":"https://www.curseforge.com/minecraft/mc-mods/oasis2","target":"_blank","rel":"noreferrer","children":["Decart"," ↗"]}],["$","a","oasis3",{"href":"https://docs.platform.decart.ai/changelog","target":"_blank","rel":"noreferrer","children":["Decart"," ↗"]}]]}]]}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"Some of this frontier targets robots."}],["$","p",null,{"children":["NVIDIA released Cosmos 3 Edge in July as a 4B-parameter world model. Its showcased driving simulation and robotics evaluations concern predicting physical consequences. They are relevant technical advances, but do not establish demand for consumer games. ",["$","span",null,{"className":"refs","children":[["$","a","cosmos",{"href":"https://blogs.nvidia.com/blog/siggraph-news-2026/","target":"_blank","rel":"noreferrer","children":["NVIDIA"," ↗"]}]]}]]}]]}]]}]
30:["$","$L49",null,{}]
31:["$","p",null,{"className":"prose","children":"The economic distinction is simple. If you generate an asset or write code once, many players can reuse it. If a model synthesizes each player’s view continuously, playing creates ongoing inference cost. Hybrid products can choose where generation is worth that expense."}]
32:["$","p",null,{"children":[["$","b",null,{"children":"More content may make selection more valuable."}]," If game supply grows, trusted recommendations, remix communities and multiplayer social loops could become more important. That is an inference to test, not an established market law."]}]
33:["$","p",null,{"className":"question-why","children":"This exposes the value of the harness and the structure of the project."}]
34:["$","details","Remix a game and explain the result.",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":["0",3]}],"Remix a game and explain the result."]}],["$","p",null,{"children":"Change one mechanic in somebody else’s game. See whether credit, permissions and dependencies remain understandable."}],["$","p",null,{"className":"question-why","children":"This tests whether remixing is a real creative workflow."}]]}]
35:["$","details","Follow the next ten creators.",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":["0",4]}],"Follow the next ten creators."]}],["$","p",null,{"children":"Who comes back? What do they make the second time? Ask for a cohort, not only a total-project count."}],["$","p",null,{"className":"question-why","children":"This separates curiosity from a repeat creative habit."}]]}]
36:["$","details","Follow the next hundred players.",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":["0",5]}],"Follow the next hundred players."]}],["$","p",null,{"children":"Where did they come from, what did they play, and who returns after seven days? Separate creators testing their own games from other players."}],["$","p",null,{"className":"question-why","children":"This tests the player proposition and the discovery loop."}]]}]
37:["$","details","Open the cost of one representative game.",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":["0",6]}],"Open the cost of one representative game."]}],["$","p",null,{"children":"Separate creation calls, repairs, hosting and any generation during play. Then consider many more players using the same game."}],["$","p",null,{"className":"question-why","children":"This reveals whether scale reuses earlier work or repeatedly pays for new inference."}]]}]
38:["$","div",null,{"className":"closing","children":[["$","p",null,{"children":"The exciting change is that far more people can turn an idea into something you can actually play."}],["$","p",null,{"children":"The next chapter will be written by products that help them make something worth playing again."}]]}]
